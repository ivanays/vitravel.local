<div id="popup-create-a" class="popup-direct">
    <div class="popup-direct__body">
        <div class="popup-direct__header">
            <h2 class="popup-direct__title">Создать окно</h2>
        </div>
        <div class="popup-direct__content">
            <div class="popup-direct__form">
                <form action="#" class="form" id="form-create-window">
                    <div class="form__inner">
                        <div class="form__left">
                            <div class="form__block">
                                <label for="form-create-winddow-startdate" class="form__label">Начало /
                                    Дата</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-winddow-startdate-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <input type="date" name="form-create-winddow-startdate"
                                            id="form-create-winddow-startdate" class="form__input" required>
                                        <sup id="form-create-window-startdate-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block">
                                <label for="form-create-window-starttime" class="form__label">Начало /
                                    Время</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-window-starttime-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <input type="time" name="form-create-window-starttime"
                                            id="form-create-window-starttime" class="form__input" required>
                                        <sup id="form-create-window-starttime-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block">
                                <label for="form-create-window-enddate" class="form__label">Конец /
                                    Дата</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-window-enddate-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <input type="date" name="form-create-window-enddate"
                                            id="form-create-window-enddate" class="form__input" required>
                                        <sup id="form-create-window-enddate-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block">
                                <label for="form-create-window-endtime" class="form__label">Конец /
                                    Время</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-window-endtime-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <input type="time" name="form-create-window-endtime"
                                            id="form-create-window-endtime" class="form__input" required>
                                        <sup id="form-create-window-endtime-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block">
                                <label for="" class="form__label">Телефон</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-window-phone-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <div id="form-create-window-phone-border" class="form__phone-border">
                                            <div id="form-create-window-phone-inner" class="form__phone-inner">
                                                <div class="form__phone-wrapper">
                                                    <div id="form-pay-phone-wrapper1">
                                                        <input id="form-create-window-phone-code1"
                                                            class="form__code form__code-1"
                                                            name="form-create-window-phone-code1" type="text"
                                                            maxlength="2" tabindex="4" placeholder="+7" required>
                                                    </div>
                                                </div>
                                                <span class="form__phone-trim form__phone-trim1">(</span>
                                                <div class="form__phone-wrapper">
                                                    <div id="form-window-phone-wrapper2">
                                                        <input id="form-create-window-phone-code2"
                                                            class="form__code form__code-2"
                                                            name="form-create-window-phone-code2" type="text"
                                                            maxlength="3" tabindex="5" placeholder="999" required>
                                                    </div>
                                                </div>
                                                <span class="form__phone-trim form__phone-trim2">)</span>
                                                <div class="form-phone-wrapper">
                                                    <div id="form-window-phone-wrapper3">
                                                        <input id="form-create-window-phone-code3"
                                                            class="form__code form__code-3"
                                                            name="form-create-window-phone-code3" type="text"
                                                            maxlength="3" tabindex="6" placeholder="999" required>
                                                    </div>
                                                </div>
                                                <span class="form__phone-trim form__phone-trim3">-</span>
                                                <div class="form-phone-wrapper">
                                                    <div id="form-window-phone-wrapper4">
                                                        <input id="form-create-window-phone-code4"
                                                            class="form__code form__code-4"
                                                            name="form-create-window-phone-code4" type="text"
                                                            maxlength="4" tabindex="7" placeholder="9999" required>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <sup id="form-create-window-phone-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block">
                                <label for="form-create-window-name" class="form__label">ФИО</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-pay-name-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <input type="text" name="form-create-window-name" id="form-create-window-name"
                                            class="form__input" required>
                                        <sup id="form-create-window-name-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block-groups">
                                <label for="form-create-window-course" class="form__label">Курсы</label>
                                <div class="form__phone-wrapper">
                                    <div class="form__radio-border form__radio-border2">
                                        <ul class="form__radio-items" id="form-create-window-course">
                                            <li class="form__radio-item">
                                                <div class="form__radio-inner">
                                                    <span class="form__radio-name">Курс 1</span>
                                                    <div class="form__radio-body">
                                                        <label class="party__radio-label">
                                                            <input name="window-course-redio-group" value="1"
                                                                id="window-course-redio-group1" class="party__radio"
                                                                type="radio" checked>
                                                            <span class="party__radio-fake"
                                                                id="window-course-radio-fake-group1"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="form__radio-item">
                                                <div class="form__radio-inner">
                                                    <span class="form__radio-name">Курс 2</span>
                                                    <div class="form__radio-body">
                                                        <label class="party__radio-label">
                                                            <input name="window-course-redio-group" value="1"
                                                                id="window-course-redio-group1" class="party__radio"
                                                                type="radio">
                                                            <span class="party__radio-fake"
                                                                id="window-course-radio-fake-group1"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form__right">
                            <div class="form__block-groups form__block-groups330">
                                <label for="form-create-window-course" class="form__label">Курс</label>
                                <div class="form__phone-wrapper">
                                    <div class="form__checkbox-border form__checkbox-border-group1">
                                        <div class="form__phone-wrapper">
                                            <div class="form__checkbox-inner">
                                                <span
                                                    class="form__checkbox-name form__checkbox-name-seances">Сеанcы</span>
                                                <div class="form__checkbox-body">
                                                    <label for="window-course-checkbox-seances"
                                                        class="party__checkbox-label">
                                                        <input name="window-course-checkbox-seances"
                                                            id="window-course-checkbox-seances" class="party__checkbox"
                                                            type="checkbox">
                                                        <span class="party__checkbox-fake"
                                                            id="window-course-checkbox-fake-seances"></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        <ol class="form__checkbox-items form__checkbox-items-ol"
                                            id="form-create-window-course-seances">
                                            <li class="form__checkbox-item">
                                                <div class="form__checkbox-inner">
                                                    <span class="form__checkbox-name form__checkbox-name-ol">Сеанс
                                                        1</span>
                                                    <div class="form__checkbox-body">
                                                        <label class="party__checkbox-label">
                                                            <input name="window-course-checkbox-seance1"
                                                                id="window-course-checkbox-seance1"
                                                                class="party__checkbox" type="checkbox">
                                                            <span class="party__checkbox-fake"
                                                                id="window-course-checkbox-fake-seance1"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="form__checkbox-item">
                                                <div class="form__checkbox-inner">
                                                    <span class="form__checkbox-name form__checkbox-name-ol">Сеанс
                                                        2</span>
                                                    <div class="form__checkbox-body">
                                                        <label class="party__checkbox-label">
                                                            <input name="window-course-checkbox-seance2"
                                                                id="window-course-checkbox-seance2"
                                                                class="party__checkbox" type="checkbox">
                                                            <span class="party__checkbox-fake"
                                                                id="window-course-checkbox-fake-seance2"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                        </ol>
                                    </div>
                                </div>

                            </div>
                            <div class="form__block">
                                <label for="form-create-window-course-label-price" class="form__label">Стоимость</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-seance-price-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <input type="number" min="0" name="form-create-window-course-price"
                                            id="form-create-window-course-price" class="form__input">
                                        <sup id="form-create-window-course-price-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div
                                class="form__block-description form__block-description-groups form__block-description-groups1">
                                <textarea class="form__description-groups" name="form-create-window-description"
                                    id="form-create-window-description" style="width:98.3%; height:150px;"
                                    placeholder="Описание"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
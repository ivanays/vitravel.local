<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script defer src="/js/jquery/jquery.min.js"></script>
    <script defer src="/js/dayjs/dayjs.min.js"></script>
    <script defer src="/js/dayjs/locale_ru.js"></script>
    <script defer src="/js/dayjs/add_locale_ru.js"></script>
    <script defer src="/js/lodash/lodash.js"></script>
    <title>snv-adminka-вход</title>
</head>

<body>
    <div class="wrapper">
        <section class="header">
            <div class="adminka-header">
                <div class="adminka-header__inner">
                    <a href="/adminka.html" id="adminka-header-logo" class="adminka-header__logo">SNV</a>
                </div>
            </div>
        </section>
        <section class="main">
            <div class="main__inner">
                <div class="adminka-into">
                    <h1 class="adminka-into__title">Админка</h1>
                    <div class="adminka-into__form">
                        <form id="form-into" action="#" class="form">
                            <div class="form__block">
                                <label for="form-into-email" class="form__label">Почта</label>
                                <input type="email" id="form-into-email" class="form__input">
                            </div>
                            <div class="form__block">
                                <label for="form-into-password" class="form__label">Пароль</label>
                                <input type="password" id="form-into-password" class="form__input">
                            </div>
                            <div class="form__block">
                                <button type="submit" id="form-into-btn" class="form__btn">войти</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
        <section class="footer">
            <div class="adminka-footer">
                <p class="adminka-footer__copyright">&copy Все права защищены.</p>
            </div>
        </section>
    </div>
</body>

</html>
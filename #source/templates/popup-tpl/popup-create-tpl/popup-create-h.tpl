<div id="popup-create-h" class="popup-direct">
    <div class="popup-direct__body">
        <div class="popup-direct__header">
            <h2 class="popup-direct__title">Создать счёт</h2>
        </div>
        <div class="popup-direct__content">
            <div class="popup-direct__form">
                <form action="#" class="form" id="form-create-order">
                    <div class="form__inner">
                        <div class="form__left">
                            <div class="form__block">
                                <label for="" class="form__label">Телефон</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-order-phone-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <div id="form-create-order-phone-border" class="form__phone-border">
                                            <div id="form-create-order-phone-inner" class="form__phone-inner">
                                                <div class="form__phone-wrapper">
                                                    <div id="form-phone-wrapper1">
                                                        <input id="form-create-order-phone-code1"
                                                            class="form__code form__code-1"
                                                            name="form-create-order-phone-code1" type="text"
                                                            maxlength="2" tabindex="4" placeholder="+7" required>
                                                    </div>
                                                </div>
                                                <span class="form__phone-trim form__phone-trim1">(</span>
                                                <div class="form__phone-wrapper">
                                                    <div id="form-phone-wrapper2">
                                                        <input id="form-create-order-phone-code2"
                                                            class="form__code form__code-2"
                                                            name="form-create-order-phone-code2" type="text"
                                                            maxlength="3" tabindex="5" placeholder="999" required>
                                                    </div>
                                                </div>
                                                <span class="form__phone-trim form__phone-trim2">)</span>
                                                <div class="form-phone-wrapper">
                                                    <div id="form-phone-wrapper3">
                                                        <input id="form-create-order-phone-code3"
                                                            class="form__code form__code-3"
                                                            name="form-create-order-phone-code3" type="text"
                                                            maxlength="3" tabindex="6" placeholder="999" required>
                                                    </div>
                                                </div>
                                                <span class="form__phone-trim form__phone-trim3">-</span>
                                                <div class="form-phone-wrapper">
                                                    <div id="form-phone-wrapper4">
                                                        <input id="form-create-order-phone-code4"
                                                            class="form__code form__code-4"
                                                            name="form-create-order-phone-code4" type="text"
                                                            maxlength="4" tabindex="7" placeholder="9999" required>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <sup id="form-create-order-phone-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block">
                                <label for="form-create-order-name" class="form__label">ФИО</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-group-name-error" class="form__error"></span>
                                    <div class="form__phone-inner1">
                                        <input type="text" name="form-create-order-name" id="form-create-order-name"
                                            class="form__input" required>
                                        <sup id="form-create-order-name-star" class="form__star">*</sup>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block-groups form__block-groups15">
                                <label for="form-create-order-courses" class="form__label">Курсы</label>
                                <div class="form__phone-wrapper">
                                    <div class="form__radio-border form__radio-border2">
                                        <ul class="form__radio-items" id="form-create-order-courses">
                                            <li class="form__radio-item">
                                                <div class="form__radio-inner">
                                                    <span class="form__radio-name">Курс 1</span>
                                                    <div class="form__radio-body">
                                                        <label class="party__radio-label">
                                                            <input name="order-redio-group" value="1"
                                                                id="order-redio-group1" class="party__radio"
                                                                type="radio">
                                                            <span class="party__radio-fake"
                                                                id="order-radio-fake-group1"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="form__radio-item">
                                                <div class="form__radio-inner">
                                                    <span class="form__radio-name">Курс 2</span>
                                                    <div class="form__radio-body">
                                                        <label class="party__radio-label">
                                                            <input name="order-redio-group" value="1"
                                                                id="order-redio-group1" class="party__radio"
                                                                type="radio">
                                                            <span class="party__radio-fake"
                                                                id="order-radio-fake-group1"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block-groups">
                                <label for="form-create-order-stocks" class="form__label">Акции</label>
                                <div class="form__phone-wrapper">
                                    <div class="form__radio-border form__radio-border2">
                                        <ul class="form__radio-items" id="form-create-order-stocks">
                                            <li class="form__radio-item">
                                                <div class="form__radio-inner">
                                                    <span class="form__radio-name">Акция 1</span>
                                                    <div class="form__radio-body">
                                                        <label class="party__radio-label">
                                                            <input name="order-stock-redio-group" value="1"
                                                                id="order-stock-redio-group1" class="party__radio"
                                                                type="radio">
                                                            <span class="party__radio-fake"
                                                                id="order-stock-radio-fake-group1"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="form__radio-item">
                                                <div class="form__radio-inner">
                                                    <span class="form__radio-name">Акция 2</span>
                                                    <div class="form__radio-body">
                                                        <label class="party__radio-label">
                                                            <input name="order-stock-redio-group" value="2"
                                                                id="order-stock-redio-group2" class="party__radio"
                                                                type="radio">
                                                            <span class="party__radio-fake"
                                                                id="order-stock-radio-fake-group2"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form__right">
                            <div class="form__block">
                                <label for="form-create-seance-label-price" class="form__label">Стоимость</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-order-price-error" class="form__error"></span>
                                    <input type="number" min="0" name="form-create-order-price"
                                        id="form-create-order-price" class="form__input">
                                </div>
                            </div>
                            <div class="form__block-groups  form__block-groups15">
                                <label for="form-create-order-pays" class="form__label">Счет</label>
                                <div class="form__phone-wrapper">
                                    <div class="form__checkbox-border">
                                        <div class="form__phone-wrapper">
                                            <div class="form__checkbox-inner">
                                                <span
                                                    class="form__checkbox-name form__checkbox-name-seances">Платежи</span>
                                                <div class="form__checkbox-body">
                                                    <label class="party__checkbox-label">
                                                        <input name="order-checkbox-pays" id="order-checkbox-pays"
                                                            class="party__checkbox" type="checkbox">
                                                        <span class="party__checkbox-fake"
                                                            id="order-checkbox-fake-pays"></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        <ol class="form__checkbox-items form__checkbox-items-ol"
                                            id="form-create-order-pays">
                                            <li class="form__checkbox-item">
                                                <div class="form__checkbox-inner">
                                                    <span class="form__checkbox-name form__checkbox-name-ol">Платёж
                                                        1</span>
                                                    <div class="form__checkbox-body">
                                                        <label class="party__checkbox-label">
                                                            <input name="order-checkbox-pay1" id="order-checkbox-pay1"
                                                                class="party__checkbox" type="checkbox">
                                                            <span class="party__checkbox-fake"
                                                                id="order-checkbox-fake-pay1"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="form__checkbox-item">
                                                <div class="form__checkbox-inner">
                                                    <span class="form__checkbox-name form__checkbox-name-ol">Платёж
                                                        2</span>
                                                    <div class="form__checkbox-body">
                                                        <label class="party__checkbox-label">
                                                            <input name="order-checkbox-pay2" id="order-checkbox-pay2"
                                                                class="party__checkbox" type="checkbox">
                                                            <span class="party__checkbox-fake"
                                                                id="order-checkbox-pay2"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block">
                                <label for="form-create-order-pay" class="form__label">Оплачено</label>
                                <div class="form__phone-wrapper">
                                    <span id="form-create-order-pay-error" class="form__error"></span>
                                    <input type="number" min="0" name="form-create-order-pay" id="form-create-order-pay"
                                        class="form__input">
                                </div>
                            </div>
                            <div class="form__block-groups">
                                <label for="form-create-order-groups" class="form__label">Группы</label>
                                <div class="form__phone-wrapper">
                                    <div class="form__checkbox-border">
                                        <label for="form-checkbox-items-orders"
                                            class="form__label-category">Счета</label>
                                        <ul class="form__checkbox-items" id="form-checkbox-items-orders">
                                            <li class="form__checkbox-item">
                                                <div class="form__checkbox-inner">
                                                    <span class="form__checkbox-name">Группа 1</span>
                                                    <div class="form__checkbox-body">
                                                        <label class="party__checkbox-label">
                                                            <input name="order-checkbox-group1"
                                                                id="order-checkbox-group1" class="party__checkbox"
                                                                type="checkbox">
                                                            <span class="party__checkbox-fake"
                                                                id="order-checkbox-fake-group1"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="form__checkbox-item">
                                                <div class="form__checkbox-inner">
                                                    <span class="form__checkbox-name">Группа 2</span>
                                                    <div class="form__checkbox-body">
                                                        <label class="party__checkbox-label">
                                                            <input name="order-checkbox-group2"
                                                                id="order-checkbox-group2" class="party__checkbox"
                                                                type="checkbox">
                                                            <span class="party__checkbox-fake"
                                                                id="order-checkbox-fake-group2"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="form__block-description">
                                <textarea class="form__description" name="form-create-order-description"
                                    id="form-create-order-description" style="width:100%; height:194px;"
                                    placeholder="Описание"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>